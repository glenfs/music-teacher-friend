# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Android signing keys (never commit secrets)
keys/*.jks
keys/*.keystore
keys/*.pem
keys/*.p12

# Local agent/tooling metadata
.claude/
.codex/

# Local Godot user data/cache
.godot_userdata/

# Build/export artifacts
build/
android/
*.apk

# QA/runtime outputs
qa_screenshots/
*.log

# Web export artifacts
web/

# Temp/scratch files
*.txt
*.bat
*.sql
backup/
!assets/fonts/FONT_CREDITS.txt
!attribution.txt
!assets/LICENSES.md

# Godot editor temp files
scenes/*.tmp
