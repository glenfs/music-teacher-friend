!builds/macos/teacher/
!builds/macos/teacher/.gitkeep
!builds/macos/student/
!builds/macos/student/.gitkeep
!builds/linux/
!builds/linux/.gitkeep
!builds/linux/teacher/
!builds/linux/teacher/.gitkeep
!builds/linux/student/
!builds/linux/student/.gitkeep
android/
*.apk
*.aab
*.exe
*.pck
*.wasm
*.zip

# Cloudflare Wrangler cache
.wrangler/

# Native build intermediates
native/**/build_android/

# Pre-migration asset backups (kept locally only)
assets/audio/piano/piano_backup_pre_salamander/
# Web export bundle — kept locally but never committed
web/Note Catcher3.*
web/index.*

# QA/runtime outputs
qa_screenshots/
*.log

# Web export artifacts
web/

# Temp/scratch files
*.txt
*.bat
*.sql
backup/
*.bmp
*.bmp.import
Recording*.m4a
screen ideas/
