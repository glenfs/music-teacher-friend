# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Android signing keys (never commit secrets)
keys/*.jks
keys/*.keystore
keys/*.pem
keys/*.p12

# Local agent/tooling metadata
.claude/
.codex/

# Local Godot user data/cache
.godot_userdata/

# Build/export artifacts
build/
builds/**
!builds/
!builds/.gitkeep
!builds/windows/
!builds/windows/.gitkeep
!builds/windows/teacher/
!builds/windows/teacher/.gitkeep
!builds/windows/student/
!builds/windows/student/.gitkeep
!builds/macos/
