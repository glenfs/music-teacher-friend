func _rotate_sight_chord_values_for_inversion(values: Array, inversion: int) -> Array:
	var out: Array = []
	if values.is_empty():
		return out
	var count := values.size()
	var shift := posmod(inversion, count)
	for i in range(count):
		out.append(values[(i + shift) % count])
	return out


