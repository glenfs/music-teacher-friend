		if not _teacher_student_matches_filter(sd):
			continue
		var label := str(sd.get("name", "Unnamed"))
		_teacher_students_list.add_item(label)
		_teacher_list_student_ids.append(str(sd.get("id", "")))
	_teacher_update_analytics()


