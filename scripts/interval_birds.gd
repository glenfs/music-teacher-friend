func _on_teacher_delete_student_pressed() -> void:
	if _teacher_selected_student_id == "":
		_teacher_status_label.text = "Select a student first."
		return
	var store := _sync_teacher_store_from_runtime()
	var result: Dictionary = store.delete_student(_teacher_selected_student_id)
	_sync_runtime_from_teacher_store()
	if not bool(result.get("deleted", false)):
		_teacher_status_label.text = "Student not found."
		return
	_save_teacher_data()
	_teacher_clear_form()
	_refresh_teacher_students_list()
	_teacher_update_dashboard_empty()
	_teacher_refresh_selected_student_label()
	_teacher_status_label.text = "Student deleted."


func _on_teacher_save_student_pressed() -> void:
	var nm := _teacher_name_edit.text.strip_edges()
	if nm == "":
		_teacher_status_label.text = "Name is required."
		return
	var student_to_save: Dictionary = {}
	if _teacher_selected_student_id == "":
		student_to_save = _teacher_collect_form_into(_teacher_new_student_template())
	else:
		var idx := _teacher_find_index_by_id(_teacher_selected_student_id)
		if idx >= 0:
			var students: Array = _teacher_students_array()
			var existing_any: Variant = students[idx]
			var existing: Dictionary = {}
			if typeof(existing_any) == TYPE_DICTIONARY:
				existing = (existing_any as Dictionary).duplicate(true)
			student_to_save = _teacher_collect_form_into(existing)
		else:
			student_to_save = _teacher_collect_form_into(_teacher_new_student_template())
	var store := _sync_teacher_store_from_runtime()
	var result: Dictionary = store.save_student(student_to_save, _teacher_selected_student_id)
	_sync_runtime_from_teacher_store()
	if not bool(result.get("saved", false)):
		_teacher_status_label.text = "Unable to save student."
		return
	_teacher_selected_student_id = str(result.get("student_id", _teacher_selected_student_id))
	_save_teacher_data()
	_teacher_status_label.text = "Student created." if bool(result.get("created", false)) else "Student updated."
	_refresh_teacher_students_list()
	_teacher_refresh_selected_student_label()
	var sel_idx := -1
	for i in _teacher_list_student_ids.size():
		if _teacher_list_student_ids[i] == _teacher_selected_student_id:
			sel_idx = i
			break
	if sel_idx >= 0:
		_teacher_students_list.select(sel_idx)
		_on_teacher_student_selected(sel_idx)


func _on_teacher_student_selected(index: int) -> void:
	if index < 0 or index >= _teacher_list_student_ids.size():
		return
	var student_id := _teacher_list_student_ids[index]
	var real_idx := _teacher_find_index_by_id(student_id)
	if real_idx < 0:
		return
	var students: Array = _teacher_students_array()
	var s: Dictionary = students[real_idx]
	_teacher_selected_student_id = str(s.get("id", ""))
	var store := _sync_teacher_store_from_runtime()
	var result: Dictionary = store.set_active_student_id(_teacher_selected_student_id)
	_sync_runtime_from_teacher_store()
	if not bool(result.get("updated", false)):
		_teacher_status_label.text = "Student not found."
		return
	_save_teacher_data()
	var student_any: Variant = result.get("student", {})
	if typeof(student_any) == TYPE_DICTIONARY:
		var student: Dictionary = student_any as Dictionary
		_teacher_fill_form(student)
		_teacher_update_dashboard(student)
	_teacher_refresh_selected_student_label()
	_teacher_status_label.text = "Loaded student."


func _on_teacher_filter_changed(_idx: int) -> void:
	_refresh_teacher_students_list()


func _teacher_get_filter_id() -> int:
	if _teacher_filter_option == null:
		return 0
	return _teacher_filter_option.get_selected_id()


func _teacher_student_matches_filter(student: Dictionary) -> bool:
	var filter_id := _teacher_get_filter_id()
	var metrics: Dictionary = student.get("metrics", {})
	var ear := int(metrics.get("ear_accuracy", 0))
	var sight := int(metrics.get("sight_accuracy", 0))
	var modules := int(metrics.get("modules_completed", 0))
	match filter_id:
		1:
			return ear < 70
		2:
			return sight < 70
		3:
			return modules < 3
		_:
			return true


func _teacher_update_analytics() -> void:
	if _teacher_analytics_label == null:
		return
	var students: Array = _teacher_students_array()
	if students.is_empty():
		_teacher_analytics_label.text = "No students yet."
		return
	var ear_sum := 0
	var sight_sum := 0
	var modules_sum := 0
	var low_ear := 0
	var low_sight := 0
	for s in students:
		var sd: Dictionary = s
		var m: Dictionary = sd.get("metrics", {})
		var ear := int(m.get("ear_accuracy", 0))
		var sight := int(m.get("sight_accuracy", 0))
		var mods := int(m.get("modules_completed", 0))
		ear_sum += ear
		sight_sum += sight
		modules_sum += mods
		if ear < 70:
			low_ear += 1
		if sight < 70:
			low_sight += 1
	var n: int = max(1, students.size())
	_teacher_analytics_label.text = "Students: %d | Avg Ear: %d%% | Avg Sight: %d%% | Avg Modules: %.1f | Ear<70: %d | Sight<70: %d" % [
		students.size(),
		int(round(float(ear_sum) / float(n))),
		int(round(float(sight_sum) / float(n))),
		float(modules_sum) / float(n),
		low_ear,
		low_sight
	]


func _teacher_get_active_student_id() -> String:
	return _sync_teacher_store_from_runtime().get_active_student_id(_teacher_selected_student_id)


func _teacher_record_session_metrics(mode: int, correct_count: int, asked_count: int) -> void:
	# Phase 3: append the just-finished round to the active lesson session, if any.
	_lesson_session_record_activity_end(correct_count, asked_count)
	var store := _ensure_teacher_store()
	var result: Dictionary = store.record_session_metrics(
		_teacher_selected_student_id,
		mode,
		correct_count,
		asked_count,
		MODE_INTERVAL,
		MODE_CHORD,
		MODE_PITCH_MATCH,
		MODE_SIGHT,
		Time.get_datetime_string_from_system(),
		_teacher_now_string(),
		Callable(self, "_teacher_mode_label"),
		_session_best_streak
	)
	# Record per-item stats for weak area analysis
	var sid := store.get_active_student_id(_teacher_selected_student_id)
	if sid != "" and mode == MODE_INTERVAL:
		store.record_item_stats(sid, _interval_stats_asked, _interval_stats_correct, "interval")
	elif sid != "" and mode == MODE_CHORD:
		store.record_item_stats(sid, _chord_stats_asked, _chord_stats_correct, "chord")
	elif sid != "" and mode == MODE_PITCH_MATCH:
		store.record_item_stats(sid, _chord_stats_asked, _chord_stats_correct, "pitch_match")
	elif sid != "" and mode == MODE_SIGHT and _sight_mode == "Chords" and not _sight_chord_quality_asked.is_empty():
		# SR4 — sight chord per-quality stats persist to a distinct category so
		# the dashboard can surface them separately from ear-chord weak items.
		store.record_item_stats(sid, _sight_chord_quality_asked, _sight_chord_quality_correct, "sight_chord")
		_sight_chord_quality_asked.clear()
		_sight_chord_quality_correct.clear()
	# SR8/SS3 — per-key accuracy persists to "sight_key" category so the
	# dashboard radar can render per-student. Recorded for any sight mode.
	if sid != "" and mode == MODE_SIGHT and not _sight_per_key_asked.is_empty():
		store.record_item_stats(sid, _sight_per_key_asked, _sight_per_key_correct, "sight_key")
	_teacher_data = store.get_data()
	if not bool(result.get("updated", false)):
