		bg_sb.corner_radius_top_right = 3
		bg_sb.corner_radius_bottom_left = 3
		bg_sb.corner_radius_bottom_right = 3
		bar_bg.add_theme_stylebox_override("panel", bg_sb)
		row.add_child(bar_bg)
