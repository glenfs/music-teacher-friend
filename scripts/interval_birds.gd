	_midi_piano_viz_light(pitch, false)        # safe no-op when small viz not built
	_sight_big_piano_light(pitch, false)       # new: release the big sight piano key on MIDI release
	if _chord_explorer_active:
		_handle_midi_note_off_for_chord_explorer(pitch)


func _handle_midi_sustain_pressed() -> void:
	if not _midi_active:
		return
	if _replay_button == null or _replay_button.disabled or not _replay_button.visible:
		return
	if _is_prompt_playing or not _quiz_active:
		return
	_on_replay_pressed()


func _pop_sight_button(btn: Button) -> void:
	if btn == null or not btn.is_inside_tree():
		return
	var existing: Tween = _midi_button_pop_tweens.get(btn, null) as Tween
	if existing != null and existing.is_valid():
		existing.kill()
	btn.pivot_offset = btn.size * 0.5
	btn.scale = Vector2.ONE
	var t := create_tween()
	t.set_trans(Tween.TRANS_BACK)
	t.set_ease(Tween.EASE_OUT)
	t.tween_property(btn, "scale", Vector2(1.12, 1.12), 0.08)
	t.tween_property(btn, "scale", Vector2.ONE, 0.16)
	_midi_button_pop_tweens[btn] = t


func _stop_mic_listening() -> void:
	if _pitch_detector != null:
		_pitch_detector.stop_listening()
	_mic_listening = false
	if _mic_status_label != null:
		_mic_status_label.visible = false


func _poll_mic_pitch() -> void:
	if _pitch_detector == null or not _mic_listening:
		return
	if _awaiting_round_start or _is_prompt_playing:
		return
	if _is_sight_singing_mode() and not _accepting_answer:
		return
	var result: Dictionary = _pitch_detector.poll()
	if _is_sight_singing_mode():
		_sight_singing_capture_pitch_candidates(result)
	if not result.get("detected", false):
		if _mic_status_label != null:
			if _is_sight_singing_mode():
				var reason := str(result.get("reason", ""))
				if reason == "too_quiet":
					_mic_status_label.text = "Mic input seen, level %s - sing closer/louder." % _mic_level_text(result)
				elif reason == "stabilizing":
					_mic_status_label.text = "Mic: hold the pitch... level %s" % _mic_level_text(result)
				elif reason == "no_frames":
					var no_frame_polls := int(result.get("no_frame_polls", 0))
					if no_frame_polls > 45:
						_mic_status_label.text = "Mic: no input. Check microphone permission/device."
					else:
						_mic_status_label.text = "Mic: waiting for input..."
				elif reason == "no_pitch" or reason == "low_confidence":
					_mic_status_label.text = "Mic input seen, level %s - hold a steady vowel." % _mic_level_text(result)
				else:
					_mic_status_label.text = "Mic: listening for your voice..."
			else:
				_mic_status_label.text = "Mic: listening..."
		if _is_sight_singing_mode():
			_sight_singing_phrase_tick_no_detection(result)
		return
	var detected_name: String = str(result.get("note_name", ""))
	if detected_name.is_empty() and not _is_sight_singing_mode():
		return
	var detected_full: String = str(result.get("full_name", detected_name))
	if detected_full.is_empty() and int(result.get("midi", -1)) >= 0:
		detected_full = _pitch_match_note_label(int(result.get("midi", 60)))
	# Show what we detected, with cents-off so singers see how close they are
	# to the equal-tempered target (e.g. "Heard: G4 (+12 cents)").
	if _mic_status_label != null:
		var cents_off: float = float(result.get("cents_off", 0.0))
		if absf(cents_off) > 5.0:
			_mic_status_label.text = "Heard: %s (%+d cents)" % [detected_full, int(round(cents_off))]
		else:
			_mic_status_label.text = "Heard: %s" % detected_full
	# Route to the active mode's answer handler.
	# Pitch Match is keyboard-only.
	if _selected_mode == MODE_SIGHT and _sight_mode == "Sight Singing":
		var detected_midi: int = int(result.get("midi", -1))
		if detected_midi < 0:
			return
		_sight_singing_phrase_feed_detection(result)
	elif _selected_mode == MODE_SIGHT and _sight_mode == "Notes":
		var matched := _match_mic_note_to_sight(detected_name)
		if matched.is_empty():
			return
		_on_sight_key_chosen(matched)


func _mic_level_text(result: Dictionary) -> String:
	var rms := clampf(float(result.get("rms", 0.0)), 0.0, 1.0)
	return "%.1f%%" % (rms * 100.0)


func _match_mic_note_to_sight(detected: String) -> String:
	if _sight_key_buttons.has(detected):
		return detected
	var enharmonics := {"C#": "Db", "Db": "C#", "D#": "Eb", "Eb": "D#", "F#": "Gb", "Gb": "F#", "G#": "Ab", "Ab": "G#", "A#": "Bb", "Bb": "A#"}
	var alt: String = enharmonics.get(detected, "")
	if not alt.is_empty() and _sight_key_buttons.has(alt):
		return alt
	return detected


func _show_sight_note_name_label(is_correct: bool) -> void:
	# Float the correct note's letter directly above the notehead so the user
	# sees the answer the instant they commit. No await, no extra delay — the
	# label persists until the next round's note replaces it.
	if _sight_note_name_label == null or _staff_note == null:
		return
	if not _staff_note.visible:
		return
	_sight_note_name_label.text = _current_sight_note
	# Green when right, soft red when wrong. Outline keeps the text legible
	# against both the white note head and any ledger lines that pass nearby.
	if is_correct:
		_sight_note_name_label.add_theme_color_override("font_color", Color(0.32, 1.0, 0.46, 1.0))
	else:
		_sight_note_name_label.add_theme_color_override("font_color", Color(1.0, 0.46, 0.42, 1.0))
	# Size the label to a reasonable width, then centre it above the notehead.
	var label_w := 90.0
	var label_h := 28.0
	_sight_note_name_label.size = Vector2(label_w, label_h)
	var note_center_x: float = _staff_note.position.x + (_staff_note.size.x * 0.5)
	var top_y: float = _staff_note.position.y - label_h - 6.0  # 6px gap above the notehead
	_sight_note_name_label.position = Vector2(note_center_x - (label_w * 0.5), top_y)
	_sight_note_name_label.visible = true


func _hide_sight_note_name_label() -> void:
	if _sight_note_name_label != null:
		_sight_note_name_label.visible = false


func _on_sight_key_chosen(note_name: String, chosen_btn_override: Button = null) -> void:
	if _selected_mode != MODE_SIGHT:
		return
	if _sight_mode == "Continuous":
		var now_sec := float(Time.get_ticks_msec()) / 1000.0
		if now_sec <= _continuous_touch_suppress_any_until_sec:
			return
		if not _continuous_touch_suppress_note.is_empty() and note_name == _continuous_touch_suppress_note and now_sec <= _continuous_touch_suppress_until_sec:
			# Tablet/mobile touch can trigger both a global ScreenTouch handler (press)
			# and the Button.pressed callback (release). Ignore the duplicate release.
			_continuous_touch_suppress_note = ""
			_continuous_touch_suppress_until_sec = 0.0
			return
	if _sight_mode == "Rhythm Flow":
		_on_rhythm_flow_tap()
		return
	if _sight_mode == "Continuous":
		_on_continuous_sight_key_pressed(note_name)
		return
	if not _quiz_active or not _accepting_answer:
		return
	var quiz_token := _quiz_run_token
	_play_sight_answer_click_sfx()
	_on_player_answer_committed()

	_accepting_answer = false
	# The note is now answered — freeze the idle bounce. It restarts automatically
	# when the next question repositions the staff note (via the sight renderer).
	_stop_sight_note_bounce()
	_set_answer_buttons_enabled(false)
	_replay_button.disabled = true
	_restart_button.disabled = true

	var prev_streak := _streak
	var prev_xp := _xp
	var is_correct := note_name == _current_sight_note
	# SR8 — per-key accuracy tracking for sight notes.
	var _pk: String = str(_sight_key_signature)
	_sight_per_key_asked[_pk] = int(_sight_per_key_asked.get(_pk, 0)) + 1
	if is_correct:
		_sight_per_key_correct[_pk] = int(_sight_per_key_correct.get(_pk, 0)) + 1
	# Immediately float the correct note name above the note head — no wait. The
	# label stays visible through the feedback animation and is cleared the
	# moment the next round repositions the staff note.
	_show_sight_note_name_label(is_correct)
	var correct_btn: Button = _sight_key_buttons.get(_current_sight_note, null) as Button
	if chosen_btn_override != null and note_name == _current_sight_note:
		correct_btn = chosen_btn_override
	var chosen_btn: Button = chosen_btn_override
	if chosen_btn == null:
		chosen_btn = _sight_key_buttons.get(note_name, null) as Button
	_show_sight_note_keyboard_feedback(note_name, is_correct)
	var is_almost_right := (not is_correct) and _is_sight_note_almost_correct_natural_choice(note_name, _current_sight_note)
	if is_correct:
		_score += 1
		_streak += 1
		_maybe_play_powerup_on_streak()
		_xp += 10 + mini(_streak, 10)
		_record_question_correct()
		var granted_shield := _on_chicken_combo_correct()
		_status_label.text = "Correct! That note is %s." % _current_sight_note
		if granted_shield:
			_status_label.text += " Chicken shield ready!"
		# Fast-path right-answer feedback (~0.22s green flash). Bounce + SFX fire
		# concurrently so they don't delay the next question.
		_play_sight_note_correct_bounce_once()
		_play_success_sfx()
		await _blink_sight_feedback(null, correct_btn, 3)
	else:
		if is_almost_right:
			_streak = 0
			_xp = maxi(0, _xp - 1)
			_status_label.text = "Almost right. In this key, %s is correct (not %s)." % [_current_sight_note, note_name]
			# Fire SFX immediately (no await) so the wrong-press sound lands the
			# instant the user clicks, not after the blink animation finishes.
			_play_fail_sfx()
			await _blink_sight_feedback(chosen_btn, correct_btn, 3, char(0x26A0), Color(1.0, 0.82, 0.28, 1.0))
		else:
			var shielded := _consume_chicken_shield_on_wrong()
			if not shielded:
				_streak = 0
				if not _practice_mode_enabled:
					_lives = maxi(0, _lives - 1)
				_xp = maxi(0, _xp - 2)
				_status_label.text = "Not quite. Correct note: %s." % _current_sight_note
			else:
				_xp = maxi(0, _xp - 1)
				_status_label.text = "Shield blocked the miss. Correct note: %s." % _current_sight_note
			_play_fail_sfx()
			await _blink_sight_feedback(chosen_btn, correct_btn, 3)

	_score_label.text = "Correct: %d / %d" % [_score, _question_index]
	_refresh_meta_ui()
	_animate_sight_streak_score_feedback(prev_streak, prev_xp, _streak, _xp, _xp - prev_xp, is_correct)

	if is_correct and correct_btn != null:
		await _feed_chicken_at_target(correct_btn)
		await get_tree().create_timer(0.12).timeout
		await _fly_bird_to_start()
	else:
		await _play_hungry_reaction()
		# SR5 — post-answer teaching panel for sight notes. Mirrors the
		# 3-line interval/chord ear-mode pattern (correct/chosen · why · hint).
		# Only on wrong/almost-right; correct answers skip to save flow time.
		var note_teach_lines: Array[String] = []
		note_teach_lines.append("%s  Correct: %s   ·   You picked: %s" % [char(0x2717), _current_sight_note, note_name])
		note_teach_lines.append("Why: %s" % _sight_note_reason_text(_current_sight_note, _selected_clef))
		var note_topic := "sight_note:%s:%s:subtle" % [_current_sight_note, _selected_clef]
		var note_hint_line := _pick_topic_hint_line(note_topic, _sight_note_hint_lines(_current_sight_note, _selected_clef, false))
		if not note_hint_line.is_empty():
			note_teach_lines.append("%s  %s" % [char(0x1F4A1), note_hint_line])
		_status_label.text = "\n".join(note_teach_lines)
		await get_tree().create_timer(2.4).timeout

	await _ensure_session_controller().advance_after_answer(self, quiz_token, _question_index)


func _on_continuous_virtual_key_button_down(note_name: String) -> void:
	# Fire Note Flow/Continuous virtual piano input on button press-down (not release).
	# This avoids touch-release latency and duplicate touch/mouse-emulation callbacks on Android.
	if _selected_mode != MODE_SIGHT or _sight_mode != "Continuous":
		return
	var now_sec := float(Time.get_ticks_msec()) / 1000.0
	_continuous_touch_suppress_note = note_name
	_continuous_touch_suppress_until_sec = now_sec + 0.12
	_continuous_touch_suppress_any_until_sec = now_sec + 0.08
	_on_continuous_sight_key_pressed(note_name)


func _is_continuous_flow_sight_mode() -> bool:
	return _selected_mode == MODE_SIGHT and (_sight_mode == "Continuous" or _sight_mode == "Rhythm Flow")


func _is_rhythm_flow_mode() -> bool:
	return _selected_mode == MODE_SIGHT and _sight_mode == "Rhythm Flow"


func _flow_start_prompt_text() -> String:
	if _is_rhythm_flow_mode():
		return "Tap staff or Tap button to start count-in."
	return "Tap staff to start. Level 1"


func _flow_live_prompt_text() -> String:
	if _is_rhythm_flow_mode():
		return "Tap on the beat. Space/Enter also works."
	return "Press the key when note hits the line."


func _start_continuous_flow_after_waiting() -> void:
	if not _is_continuous_flow_sight_mode():
		return
	if not _continuous_sight_active or not _continuous_sight_waiting_start:
		return
	_continuous_sight_waiting_start = false
	_continuous_sight_spawn_timer = 0.0
	if _is_rhythm_flow_mode():
		_status_label.text = "Count-in: 1"
		_rhythm_flow_count_in_announced = 0
	else:
		# Settle any responsive layout changes first so seeded Note Flow notes spawn at the final Y positions.
		_apply_answer_mode()
		_seed_continuous_stream_near_line()
		_status_label.text = _flow_live_prompt_text()
		return
	_apply_answer_mode()


func _continuous_play_line_x() -> float:
	var frame_left := STAFF_LEFT_X - 20.0
	var frame_right := STAFF_LEFT_X + STAFF_LINE_WIDTH + 20.0
	if _note_chase_staff_frame != null and _note_chase_staff_frame.visible:
		frame_left = _note_chase_staff_frame.position.x + 14.0
		frame_right = _note_chase_staff_frame.position.x + _note_chase_staff_frame.size.x - 14.0
	return lerpf(frame_left, frame_right, 0.20)


func _continuous_spawn_x() -> float:
	if _note_chase_staff_frame != null and _note_chase_staff_frame.visible:
		return _note_chase_staff_frame.position.x + _note_chase_staff_frame.size.x - 24.0
	if _staff_area == null:
		return 860.0
	return _staff_area.size.x - 24.0


func _continuous_note_name_pool() -> Array[String]:
	return ["C", "D", "E", "F", "G", "A", "B"]


func _midi_for_note_octave(note_name: String, octave: int) -> int:
	var base_map := {"C": 0, "D": 2, "E": 4, "F": 5, "G": 7, "A": 9, "B": 11}
	return ((octave + 1) * 12) + int(base_map.get(note_name, 0))


func _continuous_keyboard_range_midis() -> Vector2i:
	if _selected_clef == "Bass":
		return Vector2i(36, 64) # C2..E4
	return Vector2i(55, 84) # G3..C6


func _refresh_continuous_keyboard_range() -> void:
	if _continuous_keyboard_row == null:
		return
	var range_midi := _continuous_keyboard_range_midis()
	for key_btn in _continuous_key_buttons:
		if key_btn == null:
			continue
		var note_name := str(key_btn.get_meta("piano_note", "C"))
		var octave := int(key_btn.get_meta("piano_octave", 4))
		var midi := _midi_for_note_octave(note_name, octave)
		var white_visible := midi >= range_midi.x and midi <= range_midi.y
		key_btn.visible = white_visible
		var black_btn := key_btn.get_node_or_null("BlackKeyButton") as Button
		if black_btn != null:
			var black_midi := midi + 1
			black_btn.visible = white_visible and black_midi >= range_midi.x and black_midi <= range_midi.y


func _try_handle_continuous_touch_key(global_pos: Vector2) -> bool:
	if _selected_mode != MODE_SIGHT or _sight_mode != "Continuous":
		return false
	if not _continuous_sight_active or _continuous_sight_waiting_start:
		return false
	# Prioritize black keys because they visually overlap white keys.
	var use_global_rect := bool(_device_profile.get("use_global_touch_rect", true))
	var touch_pad := float(_device_profile.get("touch_hit_padding", 0.0))
	for bb in _continuous_black_key_buttons:
		if bb == null or not bb.visible or bb.disabled:
			continue
		var rect := bb.get_global_rect() if use_global_rect else Rect2(bb.global_position, bb.size)
		if touch_pad > 0.0:
			rect = rect.grow(touch_pad)
		if rect.has_point(global_pos):
			var touch_note := str(bb.get_meta("piano_note", bb.text))
			_on_sight_key_chosen(touch_note)
			var now_sec := float(Time.get_ticks_msec()) / 1000.0
			_continuous_touch_suppress_note = touch_note
			_continuous_touch_suppress_until_sec = now_sec + 0.16
			_continuous_touch_suppress_any_until_sec = now_sec + 0.14
			return true
	for kb in _continuous_key_buttons:
		if kb == null or not kb.visible or kb.disabled:
			continue
		var rect := kb.get_global_rect() if use_global_rect else Rect2(kb.global_position, kb.size)
		if touch_pad > 0.0:
			rect = rect.grow(touch_pad)
		if rect.has_point(global_pos):
			var touch_note := str(kb.get_meta("piano_note", kb.text))
			_on_sight_key_chosen(touch_note)
			var now_sec := float(Time.get_ticks_msec()) / 1000.0
			_continuous_touch_suppress_note = touch_note
			_continuous_touch_suppress_until_sec = now_sec + 0.16
			_continuous_touch_suppress_any_until_sec = now_sec + 0.14
			return true
	return false


func _continuous_level_config(clef_name: String, level: int) -> Dictionary:
	var lv := clampi(level, 1, 6)
	if clef_name == "Bass":
		match lv:
			1:
				return {"bounds": Vector2i(-2, 2), "accidentals": false, "speed_mult": 0.75}
			2:
				return {"bounds": Vector2i(-4, 2), "accidentals": false, "speed_mult": 1.0}
			3:
				return {"bounds": Vector2i(-4, 12), "accidentals": false, "speed_mult": 1.0}
			4:
				return {"bounds": Vector2i(-4, 12), "accidentals": true, "speed_mult": 1.0}
			5:
				return {"bounds": Vector2i(-4, 12), "accidentals": true, "speed_mult": 1.35}
			_:
				return {"bounds": Vector2i(-4, 12), "accidentals": true, "speed_mult": 1.75}
	match lv:
		1:
			return {"bounds": Vector2i(6, 10), "accidentals": false, "speed_mult": 0.75}
		2:
			return {"bounds": Vector2i(6, 12), "accidentals": false, "speed_mult": 1.0}
		3:
			return {"bounds": Vector2i(-4, 9), "accidentals": false, "speed_mult": 1.0}
		4:
			return {"bounds": Vector2i(-4, 12), "accidentals": true, "speed_mult": 1.0}
		5:
			return {"bounds": Vector2i(-4, 12), "accidentals": true, "speed_mult": 1.35}
		_:
			return {"bounds": Vector2i(-4, 12), "accidentals": true, "speed_mult": 1.75}


func _continuous_compound_level_config(clef_name: String, reading_level: int, timing_level: int) -> Dictionary:
	# Split difficulty into reading + timing axes while preserving legacy defaults.
	var read_cfg := _continuous_level_config(clef_name, reading_level)
	var time_cfg := _continuous_level_config(clef_name, timing_level)
	var zone_mult := 1.0
	var early_mult := _continuous_sight_early_window_mult_base
	# Default values match existing behavior; timing axis can override in future.
	return {
		"reading": {
			"bounds": read_cfg.get("bounds", Vector2i(-4, 12)),
			"accidentals": bool(read_cfg.get("accidentals", false)),
			"ledger_depth_cap": 99
		},
		"timing": {
			"speed_mult": float(time_cfg.get("speed_mult", 1.0)),
			"zone_width_mult": zone_mult,
			"early_window_mult": early_mult
		},
		# Legacy passthrough for compatibility with any future callers.
		"bounds": read_cfg.get("bounds", Vector2i(-4, 12)),
		"accidentals": bool(read_cfg.get("accidentals", false)),
		"speed_mult": float(time_cfg.get("speed_mult", 1.0))
	}


func _continuous_choose_accidental_for_letter(letter: String) -> String:
	var opts: Array[String] = []
	# Keep accidental spellings simple/readable for training.
	if letter != "E" and letter != "B":
		opts.append("#")
	if letter != "C" and letter != "F":
		opts.append("b")
	if opts.is_empty():
		return ""
	return opts[_rng.randi_range(0, opts.size() - 1)]


func _continuous_build_pattern_steps(bounds: Vector2i) -> Array[int]:
	var motifs: Array[Array] = [
		[0, 2, 4, 7],    # triad up to octave
		[0, 4, 2, 7],    # broken triad variation
		[0, 2, 4, 2],    # arpeggio turn
		[0, -2, -4, -7], # descending triad
		[0, -4, -2, -7], # descending variation
		[0, 1, 2, 4],    # scale fragment
		[0, -1, -2, -4]  # descending scale fragment
	]
	var motif: Array = motifs[_rng.randi_range(0, motifs.size() - 1)]
	var min_off := 999
	var max_off := -999
	for off_v in motif:
		var off := int(off_v)
		min_off = mini(min_off, off)
		max_off = maxi(max_off, off)
	var root_min := bounds.x + max_off
	var root_max := bounds.y + min_off
	if root_min > root_max:
		var out_fallback: Array[int] = []
		for i in range(4):
			out_fallback.append(_rng.randi_range(bounds.x, bounds.y))
		return out_fallback
	var root_step := _rng.randi_range(root_min, root_max)
	var out: Array[int] = []
	for off_v in motif:
		out.append(root_step - int(off_v))
	return out


func _continuous_build_next_bar_queue(bounds: Vector2i) -> void:
	if _continuous_bar_note_index == 0:
		_continuous_bar_accidentals.clear()
	var pattern_steps: Array[int] = []
	for attempt in range(12):
		pattern_steps = _continuous_build_pattern_steps(bounds)
		if pattern_steps.is_empty():
			continue
		if _continuous_last_spawn_step == 9999 or absi(int(pattern_steps[0]) - _continuous_last_spawn_step) <= 7:
			break
	if not pattern_steps.is_empty() and _continuous_last_spawn_step != 9999 and absi(int(pattern_steps[0]) - _continuous_last_spawn_step) > 7:
		var first_step := int(pattern_steps[0])
		var delta := first_step - _continuous_last_spawn_step
		var target_first := _continuous_last_spawn_step + clampi(delta, -7, 7)
		var shift := target_first - first_step
		for i in range(pattern_steps.size()):
			pattern_steps[i] = clampi(int(pattern_steps[i]) + shift, bounds.x, bounds.y)
	for i in range(pattern_steps.size()):
		var step := int(pattern_steps[i])
		if _continuous_last_spawn_step != 9999 and absi(step - _continuous_last_spawn_step) > 7:
			step = _continuous_last_spawn_step + clampi(step - _continuous_last_spawn_step, -7, 7)
			step = clampi(step, bounds.x, bounds.y)
		var letter := _staff_step_name_for_clef(step, _selected_clef)
		var prior_acc := str(_continuous_bar_accidentals.get(letter, ""))
		var effective_acc := prior_acc
		var explicit_symbol := ""
		var explicit_token := ""
		if _continuous_sight_allow_accidentals:
			if prior_acc != "" and _rng.randf() < _continuous_natural_probability:
				effective_acc = ""
				explicit_symbol = char(0x266E)
				_continuous_bar_accidentals[letter] = ""
			elif _rng.randf() < _continuous_accidental_probability:
				var chosen := _continuous_choose_accidental_for_letter(letter)
				if chosen != "" and chosen != prior_acc:
					effective_acc = chosen
					explicit_token = chosen
					explicit_symbol = char(0x266F) if chosen == "#" else char(0x266D)
					_continuous_bar_accidentals[letter] = chosen
		var bar_line_here := _continuous_bar_note_index == 0 and _continuous_total_spawned_notes > 0
		_continuous_spawn_queue.append({
			"step": step,
			"letter": letter,
			"name": letter + effective_acc,
			"display_name": letter + explicit_symbol,
			"acc_symbol": explicit_symbol,
			"bar_line": bar_line_here
		})
		_continuous_bar_note_index += 1
		_continuous_total_spawned_notes += 1
		_continuous_last_spawn_step = step
		if _continuous_bar_note_index >= 4:
			_continuous_bar_note_index = 0
			_continuous_bar_accidentals.clear()


func _continuous_take_next_note_spec(bounds: Vector2i) -> Dictionary:
	if _continuous_spawn_queue.is_empty():
		_continuous_build_next_bar_queue(bounds)
	if _continuous_spawn_queue.is_empty():
		var s := _rng.randi_range(bounds.x, bounds.y)
		var l := _staff_step_name_for_clef(s, _selected_clef)
		return {"step": s, "letter": l, "name": l, "display_name": l, "acc_symbol": "", "bar_line": false}
	return _continuous_spawn_queue.pop_front()


func _apply_continuous_level_profile() -> void:
	var reading_lv := clampi(_continuous_sight_level + _continuous_reading_difficulty_bias, 1, 6)
	var timing_lv := clampi(_continuous_sight_level + _continuous_timing_difficulty_bias, 1, 6)
	_continuous_reading_level = reading_lv
	_continuous_timing_level = timing_lv
	var cfg := _continuous_compound_level_config(_selected_clef, reading_lv, timing_lv)
	var read_cfg: Dictionary = cfg.get("reading", {})
	var time_cfg: Dictionary = cfg.get("timing", {})
	_continuous_sight_level_bounds = read_cfg.get("bounds", Vector2i(-4, 12))
	_continuous_sight_allow_accidentals = bool(read_cfg.get("accidentals", false))
	_continuous_sight_speed = _continuous_sight_base_speed * float(time_cfg.get("speed_mult", 1.0))
	_continuous_sight_hit_window = _continuous_sight_hit_window_base * float(time_cfg.get("zone_width_mult", 1.0))
	_continuous_sight_zone_width = _continuous_sight_zone_width_base * float(time_cfg.get("zone_width_mult", 1.0))
	_continuous_sight_early_window_mult = float(time_cfg.get("early_window_mult", _continuous_sight_early_window_mult_base))
	_continuous_accidental_probability = 0.08 if _continuous_sight_level >= 4 else 0.0
	_continuous_natural_probability = 0.20 if _continuous_sight_level >= 4 else 0.0
	_continuous_apply_assist_modifiers()


func _continuous_required_correct_for_level(level: int) -> int:
	# Slower level pacing so each level has enough note volume to feel intentional.
	return maxi(0, (level - 1) * 12)


func _continuous_try_level_up() -> void:
	var leveled := false
	while _continuous_sight_level < 6 and _continuous_sight_correct_hits >= _continuous_required_correct_for_level(_continuous_sight_level + 1):
		_continuous_sight_level += 1
		_lives += 1
		leveled = true
	if leveled:
		_apply_continuous_level_profile()
		_status_label.text = "Level %d unlocked (+1 Life)" % _continuous_sight_level
		# Keep Note Flow continuous across level-ups; existing notes remain on screen.
		_continuous_rest_bar_active = false
		_continuous_rest_bar_timer = 0.0
		_set_continuous_rest_symbol_visible(false)
		_apply_answer_mode()
		_refresh_meta_ui()


func _continuous_apply_assist_modifiers() -> void:
	# Adaptive assist adjusts readability/timing feel temporarily without changing scoring.
	var assist := clampi(_continuous_assist_level, 0, 2)
	if assist <= 0:
		return
	var slow_mult := 0.94 if assist == 1 else 0.88
	var zone_mult := 1.10 if assist == 1 else 1.20
	var early_mult := 1.08 if assist == 1 else 1.16
	_continuous_sight_speed *= slow_mult
	# Scale the already-applied timing profile so custom timing-axis config remains intact.
	_continuous_sight_hit_window *= zone_mult
	_continuous_sight_zone_width *= zone_mult
	_continuous_sight_early_window_mult *= early_mult


func _continuous_note_ledger_depth(step: int) -> int:
	return _ledger_steps_for_note_step(step).size()


func _continuous_note_center_y_for_step(step: int) -> float:
	var y := _staff_center_y_for_step(step)
	# Continuous Note Flow noteheads look slightly low on the first outer space beyond the staff
	# (e.g. treble B3 / bass B3 depending on clef). Nudge them up a touch for readability.
	if _selected_clef == "Treble" and step == 11:
		y -= 3.0
	elif _selected_clef == "Bass" and step == -1:
		y -= 3.0
	return y


func _continuous_append_miss_log(reason: String, note_name: String, step: int) -> void:
	var ledger_depth := _continuous_note_ledger_depth(step)
	var clean_reason := reason.strip_edges()
	if clean_reason.is_empty():
		clean_reason = "Miss"
	_continuous_miss_log.append({
		"t": _continuous_sight_elapsed,
		"r": clean_reason,
		"n": note_name,
		"s": step,
		"l": ledger_depth
	})
	if _continuous_miss_log.size() > 32:
		_continuous_miss_log.remove_at(0)
	if _continuous_miss_reason_counts.has(clean_reason):
		_continuous_miss_reason_counts[clean_reason] = int(_continuous_miss_reason_counts[clean_reason]) + 1
	_continuous_miss_note_counts[note_name] = int(_continuous_miss_note_counts.get(note_name, 0)) + 1
	_continuous_miss_step_counts[step] = int(_continuous_miss_step_counts.get(step, 0)) + 1
	_continuous_miss_ledger_depth_counts[ledger_depth] = int(_continuous_miss_ledger_depth_counts.get(ledger_depth, 0)) + 1
	_continuous_recent_miss_times.append(_continuous_sight_elapsed)
	while _continuous_recent_miss_times.size() > 8:
		_continuous_recent_miss_times.remove_at(0)
	while not _continuous_recent_miss_times.is_empty() and (_continuous_sight_elapsed - float(_continuous_recent_miss_times[0])) > 3.0:
		_continuous_recent_miss_times.remove_at(0)
	if _continuous_adaptive_assist_enabled and _continuous_recent_miss_times.size() >= 3:
		var newest := float(_continuous_recent_miss_times[_continuous_recent_miss_times.size() - 1])
		var oldest := float(_continuous_recent_miss_times[_continuous_recent_miss_times.size() - 3])
		if (newest - oldest) <= 2.4:
			_continuous_assist_level = mini(2, _continuous_assist_level + 1)
			_continuous_assist_recovery_hits = 0
			_apply_continuous_level_profile()


func _continuous_try_recover_adaptive_assist() -> void:
	if not _continuous_adaptive_assist_enabled:
		return
	if _continuous_assist_level <= 0:
		return
	_continuous_assist_recovery_hits += 1
	if _continuous_assist_recovery_hits >= (4 + (_continuous_assist_level * 2)):
		_continuous_assist_level = maxi(0, _continuous_assist_level - 1)
		_continuous_assist_recovery_hits = 0
		_apply_continuous_level_profile()


func _continuous_problem_area_summary() -> String:
	var top_note := ""
	var top_note_count := 0
	for k in _continuous_miss_note_counts.keys():
		var c := int(_continuous_miss_note_counts[k])
		if c > top_note_count:
			top_note_count = c
			top_note = str(k)
	var top_ledger_depth := -1
	var top_ledger_count := 0
	for k in _continuous_miss_ledger_depth_counts.keys():
		var c := int(_continuous_miss_ledger_depth_counts[k])
		if c > top_ledger_count:
			top_ledger_count = c
			top_ledger_depth = int(k)
	var top_reason := ""
	var top_reason_count := 0
	for k in _continuous_miss_reason_counts.keys():
		var c := int(_continuous_miss_reason_counts[k])
		if c > top_reason_count:
			top_reason_count = c
			top_reason = str(k)
	if top_note_count <= 0 and top_ledger_count <= 0 and top_reason_count <= 0:
		return ""
	var parts: Array[String] = []
	if top_note_count > 0:
		parts.append("note %s x%d" % [top_note, top_note_count])
	if top_ledger_count > 0 and top_ledger_depth > 0:
		parts.append("ledger depth %d x%d" % [top_ledger_depth, top_ledger_count])
	if top_reason_count > 0:
		parts.append("%s x%d" % [top_reason, top_reason_count])
	return "Problem areas: %s" % ", ".join(parts.slice(0, 3))


